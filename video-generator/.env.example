# RunComfy Model API token — get it from your profile page (avatar, upper right)
# at https://www.runcomfy.com after signing in.
RUNCOMFY_API_TOKEN=

# Anthropic API key — used by the planner to turn a topic into a scene plan.
# Not needed if you always pass --plan-file or run with --dry-run + --plan-file.
ANTHROPIC_API_KEY=
