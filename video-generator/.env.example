# RunComfy Model API token — get it from your profile page (avatar, upper right)
# at https://www.runcomfy.com after signing in.
RUNCOMFY_API_TOKEN=

# Story/scene planner. DeepSeek is the default (--planner deepseek);
# set the key for whichever provider you use.
DEEPSEEK_API_KEY=
# For --planner minimax (key from https://www.minimax.io platform console)
MINIMAX_API_KEY=
# Only for --planner claude (also requires: pip install anthropic)
ANTHROPIC_API_KEY=
